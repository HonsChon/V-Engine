#version 450
#extension GL_GOOGLE_include_directive : enable

/**
 * Cluster Culling & LOD Selection Compute Shader
 * 
 * Nanite 风格的 DAG 节点独立决策 LOD 选择：
 * 
 * 渲染一个 cluster 的条件：
 *   selfScreenError <= threshold < parentScreenError
 * 
 * 即该 cluster 是"刚好足够精细"的层级。
 * 这保证了每个表面区域恰好被一个 cluster 覆盖（无镂空、无重叠）。
 */

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// ============== 数据结构 ==============

struct ClusterData {
    vec4 boundingSphere;    // xyz: center, w: radius
    vec4 aabbMin;           // xyz: min, w: lodError
    vec4 aabbMax;           // xyz: max, w: maxChildError
    vec4 normalCone;        // xyz: axis, w: cos(angle)
    
    uint meshIndex;         // 所属 mesh 的索引（用于 TransformBuffer 查世界矩阵）
    uint indexOffset;
    uint triangleCount;
    uint lodLevel;
    
    uint parentGroupIndex;  // 父节点索引 (0xFFFFFFFF = 根节点)
    uint flags;             // bit0=enabled, bit1=isLeaf
    uint childStartIndex;
    uint childCount;
};

// ============== Uniform 数据 ==============

layout(set = 0, binding = 0) uniform CullingUniforms {
    mat4 viewMatrix;
    mat4 projMatrix;
    mat4 viewProjMatrix;
    vec4 frustumPlanes[6];
    vec4 cameraPosition;
    uvec4 clusterCountPacked;   // x=count, y=frustumCull, z=coneCull, w=lodSelect
    vec4 screenParams;          // x=width, y=height, z=lodErrorScale, w=pixelThreshold
} uniforms;

#define CLUSTER_COUNT uniforms.clusterCountPacked.x
#define ENABLE_FRUSTUM_CULL (uniforms.clusterCountPacked.y != 0u)
#define ENABLE_CONE_CULL (uniforms.clusterCountPacked.z != 0u)
#define ENABLE_LOD_SELECTION (uniforms.clusterCountPacked.w != 0u)
#define SCREEN_WIDTH uniforms.screenParams.x
#define SCREEN_HEIGHT uniforms.screenParams.y
#define LOD_ERROR_SCALE uniforms.screenParams.z
#define PIXEL_THRESHOLD uniforms.screenParams.w

// ============== 缓冲区 ==============

// (无 readonly: DX12 端 RHI StorageBuffer 一律按 UAV 描述符/root table 绑定;
//  readonly 会使 spirv-cross 输出 SRV 而 HLSL 侧与 UAV 模型失配)
layout(set = 0, binding = 1) buffer ClusterBuffer {
    ClusterData clusters[];
};

layout(set = 0, binding = 2) buffer TransformBuffer {
    mat4 transforms[];
};

layout(set = 0, binding = 3) writeonly buffer VisibleBuffer {
    uint visibleClusterIndices[];
};

layout(set = 0, binding = 4) buffer CounterBuffer {
    uint visibleClusterCount;
};

layout(set = 0, binding = 5) buffer SelectionStateBuffer {
    uint selectionState[];
};

// ============== 辅助函数 ==============

float signedDistanceToPlane(vec4 plane, vec3 point) {
    return dot(plane.xyz, point) + plane.w;
}

bool frustumCullSphere(vec3 center, float radius) {
    for (int i = 0; i < 6; ++i) {
        float dist = signedDistanceToPlane(uniforms.frustumPlanes[i], center);
        if (dist < -radius) {
            return false;
        }
    }
    return true;
}

bool coneCull(vec3 coneAxis, float coneCosAngle, vec3 clusterCenter, vec3 cameraPos) {
    if (coneCosAngle <= 0.0) {
        return true;
    }
    vec3 viewDir = normalize(cameraPos - clusterCenter);
    float viewDotCone = dot(viewDir, coneAxis);
    // 背面剔除条件: dot(viewDir, axis) < -sin(θ) = -sqrt(1 - cos²θ)
    // (此前误用 -cosθ,对半角 >45° 的宽锥会过度剔除)
    float sinConeAngle = sqrt(max(0.0, 1.0 - coneCosAngle * coneCosAngle));
    return viewDotCone >= -sinConeAngle;
}

/**
 * 计算包围球在屏幕上的直径（像素）
 */
float computeScreenSize(float radius, float distanceToCamera) {
    // abs(): Vulkan 端投影已做 Y 翻转(proj[1][1] < 0),这里取模长保证误差为正
    float projScaleY = abs(uniforms.projMatrix[1][1]);
    
    if (distanceToCamera <= 0.001) {
        return 10000.0;
    }
    
    return (2.0 * radius * projScaleY * SCREEN_HEIGHT * 0.5) / distanceToCamera;
}

/**
 * 计算世界空间误差投影到屏幕空间的像素数
 */
float computeScreenSpaceError(float lodError, float distanceToCamera) {
    // abs(): 同 computeScreenSize,兼容 Vulkan 的 Y 翻转投影
    float projScaleY = abs(uniforms.projMatrix[1][1]);
    
    if (distanceToCamera <= 0.001) {
        return 10000.0;
    }
    
    float screenError = (lodError * projScaleY * SCREEN_HEIGHT * 0.5) / distanceToCamera;
    return screenError * LOD_ERROR_SCALE;
}

// ============== 主函数 ==============

void main() {
    uint clusterIndex = gl_GlobalInvocationID.x;
    
    if (clusterIndex >= CLUSTER_COUNT) {
        return;
    }
    
    ClusterData cluster = clusters[clusterIndex];
    
    // 检查是否启用
    if ((cluster.flags & 1u) == 0u) {
        return;
    }
    
    // 世界空间变换：每个 mesh 一个世界矩阵（由 CPU 按 mesh 顺序上传）
    mat4 worldMatrix = transforms[cluster.meshIndex];
    vec3 worldCenter = (worldMatrix * vec4(cluster.boundingSphere.xyz, 1.0)).xyz;
    float distanceToCamera = length(worldCenter - uniforms.cameraPosition.xyz);
    
    // 非均匀/均匀缩放：包围球半径按最大轴缩放放大（保守，避免缩放后过度剔除）
    float maxScale = max(max(length(worldMatrix[0].xyz), length(worldMatrix[1].xyz)),
                         length(worldMatrix[2].xyz));
    float worldRadius = cluster.boundingSphere.w * maxScale;
    
    // ============================================================
    // Nanite DAG LOD 选择
    //
    // 核心原则（UE5 Nanite）：
    //
    // 渲染条件 = "自身误差可接受" AND "父节点误差不可接受"
    //
    //   selfScreenError <= threshold < parentScreenError
    //
    // 保证：
    // - 在 DAG 的每条根→叶路径上，恰好选中一个节点
    // - 无镂空（每个区域都被覆盖）
    // - 无重叠（每个区域只有一个 LOD）
    //
    // 特殊情况：
    // - 根节点（无父）：parentError 视为无穷大，总是不可接受
    // - 叶节点（LOD0）：selfError = 0，总是可接受
    // ============================================================
    
    if (ENABLE_LOD_SELECTION) {
        float selfError = computeScreenSpaceError(cluster.aabbMin.w, distanceToCamera);
        
        float parentError = 1e30;
        uint parentIndex = cluster.parentGroupIndex;
        if (parentIndex != 0xFFFFFFFFu && parentIndex < CLUSTER_COUNT) {
            ClusterData parent = clusters[parentIndex];
            mat4 parentWorld = transforms[parent.meshIndex];
            vec3 parentCenter = (parentWorld * vec4(parent.boundingSphere.xyz, 1.0)).xyz;
            float parentDistance = length(parentCenter - uniforms.cameraPosition.xyz);
            parentError = computeScreenSpaceError(parent.aabbMin.w, parentDistance);
        }
        
        if (!(selfError <= PIXEL_THRESHOLD && parentError > PIXEL_THRESHOLD)) {
            return;
        }
    }
    
    // ============================================
    // 视锥剔除
    // ============================================
    if (ENABLE_FRUSTUM_CULL) {
        if (!frustumCullSphere(worldCenter, worldRadius)) {
            return;
        }
    }
    
    // ============================================
    // 法线锥背面剔除
    // ============================================
    if (ENABLE_CONE_CULL) {
        // 法线锥轴是局部空间方向，需用逆转置矩阵变换到世界空间
        mat3 normalMatrix = transpose(inverse(mat3(worldMatrix)));
        vec3 coneAxis = normalize(normalMatrix * cluster.normalCone.xyz);
        float coneCosAngle = cluster.normalCone.w;
        if (!coneCull(coneAxis, coneCosAngle, worldCenter, uniforms.cameraPosition.xyz)) {
            return;
        }
    }
    
    // 输出到可见列表
    uint outputIndex = atomicAdd(visibleClusterCount, 1);
    visibleClusterIndices[outputIndex] = clusterIndex;
}